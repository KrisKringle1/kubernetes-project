# ============================================================================
# REFERENCE ONLY: How a Spring Boot Dockerfile compares to our Python Dockerfile
# ============================================================================
# At work with Java & Spring Boot, you typically use a "Multi-Stage Build":
#   - Stage 1 uses a full JDK + Maven/Gradle image to compile the .jar
#   - Stage 2 copies ONLY the compiled .jar into a tiny JRE image for production

# --- Stage 1: Build the JAR (Maven + JDK 21) ---
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# Cache Maven dependencies first (just like we cached requirements.txt in Python!)
COPY pom.xml .
RUN mvn dependency:go-offline

# Copy Java source code and build the executable Spring Boot fat JAR
COPY src ./src
RUN mvn clean package -DskipTests

# --- Stage 2: Production Runtime (Lightweight JRE 21 only) ---
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copy only the built JAR from Stage 1 (leaves Maven & source code behind!)
COPY --from=builder /build/target/*.jar app.jar

EXPOSE 8080

# Run the Spring Boot application
CMD ["java", "-jar", "app.jar"]
